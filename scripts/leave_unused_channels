# scripts/leave_unused_channels.py
import os
import asyncio
import sqlite3
from telethon import TelegramClient
from telethon.tl.types import Channel

DB_PATH = os.getenv("DB_PATH", "post_watchdog.sqlite3")
API_ID = int(os.getenv("TG_API_ID", "23138928"))
API_HASH = os.getenv("TG_API_HASH", "969a05668d0fd9bff53937329f2c0dd3")
SESSION_NAME = os.getenv("SESSION_NAME", "tg_session")  # без .session
LEAVE_DELAY = float(os.getenv("LEAVE_DELAY_SEC", "1.0"))

def load_used_channel_ids() -> set[int]:
    con = sqlite3.connect(DB_PATH)
    cur = con.cursor()
    cur.execute("SELECT id FROM channels")  # основна таблиця каналів
    rows = cur.fetchall()
    con.close()
    return {int(r[0]) for r in rows if r and r[0] is not None}

async def main():
    used = load_used_channel_ids()
    print(f"DB: {DB_PATH}, used channels={len(used)}")
    session_path = f"{SESSION_NAME}.session"
    client = TelegramClient(session_path, API_ID, API_HASH)

    to_leave = []
    async with client:
        async for dlg in client.iter_dialogs():
            ent = dlg.entity
            if isinstance(ent, Channel):
                cid = int(getattr(ent, "id", 0) or 0)
                if cid and cid not in used:
                    to_leave.append(cid)

        print(f"Found {len(to_leave)} channels/supergroups not in DB -> leaving")
        for cid in to_leave:
            try:
                await client.delete_dialog(cid)
                print(f"Left channel_id={cid}")
                await asyncio.sleep(LEAVE_DELAY)
            except Exception as e:
                print(f"Failed to leave channel_id={cid}: {e}")

if __name__ == "__main__":
    asyncio.run(main())
